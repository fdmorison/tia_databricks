SPARK_HOME=.venv/lib/python3.11/site-packages/pyspark
SPARK_LOCAL_IP=127.0.0.1

# Workspace URL and service principal credentials.
# Used by DatabricksConnectRunner and DatabricksExternalRunner.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Used only by DatabricksConnectRunner, which executes the job on this cluster.
DATABRICKS_CLUSTER_ID=
